# ExamPilot — optional environment overrides.
# The primary way to configure keys is the in-app Settings → Providers screen
# (stored in your OS user-data dir). Env vars below are used as a fallback
# when a provider has no key saved in Settings.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Azure OpenAI (chat)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Speech-to-text fallbacks
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local Whisper CLI (offline transcription, optional)
WHISPER_COMMAND=whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto

# Override the data dir (settings/sessions/logs). Default: OS userData / ~/.exampilot
# EXAMPILOT_DATA_DIR=
