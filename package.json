{
  "name": "exampilot",
  "version": "0.1.0",
  "description": "ExamPilot — invisible real-time interview copilot. Listens to mic + system audio, captures screen, answers with your AI providers + automatic fallback.",
  "main": "main.js",
  "author": "ExamPilot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankitkumar131/exam.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/bundle-stt-worker.js",
    "dev": "electron . --no-sandbox --disable-gpu",
    "predev": "node scripts/bundle-stt-worker.js",
    "smoke": "node scripts/smoke.js",
    "test": "node scripts/smoke.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "bundle:worker": "node scripts/bundle-stt-worker.js",
    "build": "npm run bundle:worker && electron-builder",
    "build:win": "npm run bundle:worker && electron-builder --win",
    "build:linux": "npm run bundle:worker && electron-builder --linux",
    "build:mac": "npm run bundle:worker && electron-builder --mac",
    "rebuild": "npm run clean && npm run build"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "pdf-parse": "^1.1.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.exampilot.app",
    "productName": "ExamPilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!*.md",
      "!.git/**/*",
      "!.github/**/*",
      "!.env*",
      "!coverage/**/*",
      "!src/stt-worker/**/*",
      "!node_modules/@xenova/**/*",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/onnxruntime-node*/**/*",
      "!node_modules/onnxruntime-common/**/*",
      "!node_modules/sharp/**/*",
      "!node_modules/@huggingface/**/*"
    ],
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ExamPilot"
    },
    "linux": {
      "icon": "assets/icons/icon.png",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "ExamPilot",
      "description": "Invisible real-time interview copilot with multi-provider AI fallback."
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
